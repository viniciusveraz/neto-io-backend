# Configuração da Aplicação
PORT=3333
NODE_ENV=development
API_BASE_URL=http://localhost:3333

# Conexão com o Banco de Dados (Prisma ORM)
# Para desenvolvimento local simplificado (SQLite):
DATABASE_URL="file:./dev.db"
# Para produção / PostgreSQL (descomente caso utilize PostgreSQL):
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/neto_io?schema=public"

# Segurança e Autenticação (JWT)
JWT_SECRET="neto_io_secret_jwt_key_piaui_litoral_2026"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="*"

# Rate Limiting (Segurança / Prevenção contra abusos)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150

# Integração Clima / Vento (Open-Meteo API)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
